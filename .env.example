# Enthernet Prep AI — environment template.
# Copy to .env and fill in real values. Never commit .env.

# ─── Core ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# JWT (signed with APP_SECRET)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60

# ─── Postgres (used by backend + compose) ──────────────────────────────
POSTGRES_USER=eprep
POSTGRES_PASSWORD=eprep
POSTGRES_DB=eprep
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Async SQLAlchemy URL derived by app/config.py from the above.

# ─── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Object storage (MinIO in dev, S3 in prod) ─────────────────────────
S3_ENDPOINT_URL=http://minio:9000
# S3_PUBLIC_ENDPOINT_URL is used to sign presigned URLs the browser/CLI will follow.
# In dev it's the host-mapped MinIO port; in prod set to the public S3 URL.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=eprep-minio
S3_SECRET_KEY=eprep-minio-secret
S3_BUCKET=eprep-uploads
S3_REGION=us-east-1

# Document ingest limits (§17/§18)
DOCUMENT_MAX_SIZE_BYTES=26214400
DOCUMENT_PRESIGN_TTL_SECONDS=300
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=150

# ─── Frontend ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# ─── LLM providers (placeholders — never commit real keys) ─────────────
# Only one is required to run any agent code; leave others blank.
GEMINI_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL lets you point at OpenAI-compatible endpoints
# (Together, Ollama, vLLM, etc.). Leave blank for real OpenAI.
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
AWS_BEDROCK_REGION=

# Provider selection (mock is deterministic + offline; openai needs OPENAI_API_KEY)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Retrieval knobs (§21)
RETRIEVAL_DEFAULT_K=8
RETRIEVAL_MAX_K=50

# ─── Alexa+ (filled in later, §31/§32) ─────────────────────────────────
ALEXA_SKILL_ID=
ALEXA_CLIENT_ID=
ALEXA_CLIENT_SECRET=
